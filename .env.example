# Copy to .env (or export in the container environment) with real values.
# Required by the proxy and by config.yaml.example.

# Admin key: the proxy requires it to start; all current clients authenticate
# with it (DB-less setup).
LITELLM_MASTER_KEY=

# Provider keys referenced as os.environ/... in config.yaml.example
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# --- Hook knobs (optional, see README "Environment") ---
# Config path override for both hooks (default: /app/config.yaml, then
# ./config.yaml).
#LITELLM_CONFIG_FILE=
# Verbose per-request logging (enable with 1/true).
#TIME_ROUTER_DEBUG=1
# Override UTC hour (0-23) / minute (0-59) to test window boundaries.
#TIME_ROUTER_FAKE_HOUR=
#TIME_ROUTER_FAKE_MINUTE=
# Override weekday (0=Mon..6=Sun) to test weekends.
#TIME_ROUTER_FAKE_WEEKDAY=
# session_ttl_s / max_session_entries live in config.yaml
# (callback_settings.time_router), not in the environment.

# --- reasoning_route_adapter knobs (optional, see reasoning_route_adapter/DESIGN.md) ---
# Disable the adapter entirely (rollback): requests pass through unchanged.
#REASONING_ADAPTER_DISABLED=1
# Verbose per-request logging, incl. before/after reasoning keys (1/true).
#REASONING_ADAPTER_DEBUG=1
# Route-label sets per dialect (comma-separated) - FALLBACK only: used for
# model_list entries that do NOT declare model_info.metadata.reasoning_dialect
# in config.yaml (the declared dialect is the primary classification source).
#REASONING_ADAPTER_NATIVE_ROUTES=deepseek
#REASONING_ADAPTER_OR_ROUTES=baidu/fp8
