# Reference LiteLLM config for time_router and reasoning_route_adapter.
#
# Contract required by the hooks:
#   - every model that participates in routing carries model_info.metadata.route
#     (the hooks build ROUTE_MAP from it; time_router stamps it as the
#     metadata_route label)
#   - every model that can carry reasoning control declares
#     model_info.metadata.reasoning_dialect - the entry's reasoning wire
#     contract: "deepseek" (native thinking / reasoning_effort /
#     reasoning_content) or "openrouter" (the reasoning object).
#     reasoning_route_adapter classifies by it (the route-label sets in the
#     hook are only the fallback for entries without the declaration)
#   - the alias entry declares model_info.metadata.time_router.reroute
#     (peak_target / offpeak_target); the offpeak_target entry owns the
#     provider schedule model_info.metadata.time_router.peak_windows
#     (days 0=Mon..6=Sun, start/end as HH:MM UTC, interval [start, end))
#   - hook operation knobs live in the top-level callback_settings.<hook>
#     block - NOT litellm_settings.callback_settings; each hook reads its own
#     entry (LiteLLM does not inject it into a dotted-path CustomLogger)
#   - the alias entry in model_list is the only name clients know
#   - keys are referenced as os.environ/... (see .env.example)
#
# Both hooks read their config through the shared hook_config loader:
# `time_router` uses the alias `time_router` metadata and
# `callback_settings.time_router`; the adapter classifies by the bound
# deployment's `reasoning_dialect`/`route` and reads
# `callback_settings.reasoning_route_adapter`.
#
# The hooks are imported as the modules `time_router` and
# `reasoning_route_adapter` (source under `time_router/` and
# `reasoning_route_adapter/`; both must be mounted next to this config at
# `/app/`) and registered under litellm_settings.callbacks. `time_router`
# stays first (it reroutes the alias at request level); the adapter classifies
# by the bound deployment, so its position no longer matters.

model_list:
  # Public alias - the only model clients should use. Default deployment points at
  # a safe provider: if the hook is ever disabled, alias traffic still routes.
  - model_name: litellm/deepseek-v4-flash
    litellm_params:
      model: deepseek/deepseek-v4-flash-0731
      api_base: https://openrouter.ai/api/v1
      api_key: os.environ/OPENROUTER_API_KEY
      input_cost_per_token: 0.00000004998
      output_cost_per_token: 0.00000009996
      cache_read_input_token_cost: 0.000000009996
    model_info:
      metadata:
        route: "baidu/fp8"
        reasoning_dialect: "openrouter"  # alias default deployment is OR; if it
                                        # ever reaches the adapter un-rewritten,
                                        # the OR rules apply
        time_router:
          reroute:
            peak_target: "openrouter/deepseek-v4-flash"
            offpeak_target: "deepseek/deepseek-v4-flash"

  # Off-peak target (deepseek direct API).
  - model_name: deepseek/deepseek-v4-flash
    litellm_params:
      model: deepseek/deepseek-v4-flash
      api_key: os.environ/DEEPSEEK_API_KEY
      api_base: https://api.deepseek.com/v1
      input_cost_per_token: 0.00000022
      output_cost_per_token: 0.00000066
      cache_read_input_token_cost: 0.000000007
      num_retries: 2
      timeout: 10
    model_info:
      metadata:
        route: "deepseek"
        reasoning_dialect: "deepseek"
        time_router:
          peak_windows:                 # days 0=Mon..6=Sun (datetime.weekday());
            - days: [0, 1, 2, 3, 4]     # start/end are HH:MM UTC, [start, end).
              start: "01:00"            # weekend excluded by omission.
              end: "04:00"
            - days: [0, 1, 2, 3, 4]
              start: "06:00"
              end: "10:00"

  # Peak target (via OpenRouter -> Baidu Qianfan).
  - model_name: openrouter/deepseek-v4-flash
    litellm_params:
      model: deepseek/deepseek-v4-flash-0731
      api_base: https://openrouter.ai/api/v1
      api_key: os.environ/OPENROUTER_API_KEY
      input_cost_per_token: 0.00000004998
      output_cost_per_token: 0.00000009996
      cache_read_input_token_cost: 0.000000009996
      extra_body:
        provider:
          order: ["baidu/fp8"]
          allow_fallbacks: false
    model_info:
      metadata:
        route: "baidu/fp8"
        reasoning_dialect: "openrouter"

  # Any extra models are fine; entries with a declared route get labeled.
  - model_name: deepseek/deepseek-v4-pro
    litellm_params:
      model: deepseek/deepseek-v4-pro
      api_key: os.environ/DEEPSEEK_API_KEY
      api_base: https://api.deepseek.com/v1
      input_cost_per_token: 0.00000066
      output_cost_per_token: 0.00000198
      cache_read_input_token_cost: 0.000000022
    model_info:
      metadata:
        route: "deepseek"
        reasoning_dialect: "deepseek"

general_settings:
  # User identity comes from a header, so different people sharing the master key
  # still show up under their own name in logs/metrics.
  user_header_mappings:
    - header_name: x-litellm-user-name
      litellm_user_role: internal_user
  always_include_stream_usage: true
  max_parallel_requests: 4
  global_max_parallel_requests: 8
  background_health_checks: false

# Hook operation knobs. TOP-LEVEL key (v1.99.0 reads config.get("callback_settings")),
# NOT litellm_settings.callback_settings. A CustomLogger registered by dotted
# path does not receive its block automatically, so each hook reads its own
# entry (see PLAN.md / DESIGN.md §5.1).
callback_settings:
  time_router:
    session_ttl_s: 900
    max_session_entries: 128
  reasoning_route_adapter:
    warning_interval_s: 300
    native_route_labels: ["deepseek"]
    or_route_labels: ["baidu/fp8"]

litellm_settings:
  callbacks:
    - 'prometheus'
    - 'time_router.proxy_handler_instance'
    # Normalizes reasoning control to the dialect of the bound deployment
    # (per-deployment hook; see DESIGN.md). Rollback:
    # REASONING_ADAPTER_DISABLED=1.
    - 'reasoning_route_adapter.proxy_handler_instance'
  custom_prometheus_metadata_labels:
    - "metadata.tool"
    - "metadata.client_host"
    - "metadata.route"
  json_logs: true
  modify_params: true
  request_timeout: 120

router_settings:
  # Example: degrade to the peak target if the off-peak one fails.
  fallbacks:
    - deepseek/deepseek-v4-flash: ["openrouter/deepseek-v4-flash"]
